    {
      "id": 1,
      "name": "Bract Theory",
      "location": "windgap_academy",
      "locationName": "Windgap Academy",
      "theme": "Supports without proof",
      "civicRule": "ACCESS_WITHOUT_PROOF",
      "civicRuleDescription": "Supports appear without justification required",
      "primaryMechanic": "cushion_guard_toggle",
      "npcs": [
        "DAZIE",
        "Winton"
      ],
      "introDialogue": [
        {
          "speaker": "dazie_vine",
          "text": "Most days the place does orientation for me. Not today.",
          "iconVersion": "🏛️ Usually auto-orientation. Not today.",
          "minimalVersion": "Orientation broken today.",
          "emotion": "neutral"
        },
        {
          "speaker": "dazie_vine",
          "text": "Protection that looks like beauty.",
          "iconVersion": "🛡️ = 🌸 Protection = beauty",
          "minimalVersion": "Protection as beauty.",
          "emotion": "neutral"
        },
        {
          "speaker": "winton",
          "text": "Support withheld pending justification.",
          "iconVersion": "⚠️ Support needs proof",
          "minimalVersion": "Support: needs proof",
          "emotion": "neutral"
        },
        {
          "speaker": "dazie_vine",
          "text": "That's the new rule. It's wrong. Let's rewrite the welcome.",
          "iconVersion": "❌ Bad rule. ✏️ Rewrite.",
          "minimalVersion": "Wrong rule. Rewrite it.",
          "emotion": "neutral"
        }
      ]
    },
    {
      "id": 2,
      "name": "Felt Memory",
      "location": "windgap_academy",
      "locationName": "Windgap Academy",
      "theme": "Overload as information",
      "civicRule": "BUFFERS_BY_DEFAULT",
      "civicRuleDescription": "Rest pockets and quiet routes are standard infrastructure",
      "primaryMechanic": "radiant_hold",
      "npcs": [
        "June",
        "DAZIE"
      ],
      "introDialogue": [
        {
          "speaker": "june_corrow",
          "text": "They deleted quiet because it didn't measure.",
          "iconVersion": "🤫❌ Quiet deleted - not measured",
          "minimalVersion": "Quiet deleted. Unmeasurable.",
          "emotion": "neutral"
        },
        {
          "speaker": "dazie_vine",
          "text": "It measures to me.",
          "iconVersion": "📊 Quiet measures to me.",
          "minimalVersion": "Quiet matters.",
          "emotion": "neutral"
        }
      ]
    },
    {
      "id": 3,
      "name": "Rayless Form",
      "location": "windgap_academy",
      "locationName": "Windgap Academy",
      "theme": "Equal expression modes",
      "civicRule": "PERFORMANCE_DECOUPLED_FROM_VALUE",
      "civicRuleDescription": "Expression mode does not determine worth",
      "primaryMechanic": "thread_lash",
      "npcs": [
        "DAZIE",
        "Winton"
      ],
      "introDialogue": [
        {
          "speaker": "dazie_vine",
          "text": "The Social Hall stages residents into roles. Spotlights create platforms only for 'performers'.",
          "iconVersion": "🎭 Spotlights = forced roles",
          "minimalVersion": "Spotlights force roles.",
          "emotion": "neutral"
        },
        {
          "speaker": "dazie_vine",
          "text": "You don't have to play along.",
          "iconVersion": "🚫🎭 Don't perform",
          "minimalVersion": "Don't play along.",
          "emotion": "neutral"
        },
        {
          "speaker": "winton",
          "text": "Performance decoupled from value.",
          "iconVersion": "✅ Value ≠ performance",
          "minimalVersion": "Value without performance.",
          "emotion": "neutral"
        }
      ]
    },
    {
      "id": 4,
      "name": "Umbel Logic",
      "location": "umbel_gardens",
      "locationName": "The Umbel Gardens",
      "theme": "Community as architecture",
      "civicRule": "TRANSLATION_LAYERS",
      "civicRuleDescription": "Systems accommodate different speeds and communication styles",
      "primaryMechanic": "grapple_thread",
      "npcs": [
        "June",
        "Winton"
      ],
      "introDialogue": [
        {
          "speaker": "june_corrow",
          "text": "Belonging isn't a feeling. It's architecture.",
          "iconVersion": "🏗️ Belonging = architecture",
          "minimalVersion": "Belonging is structure.",
          "emotion": "neutral"
        },
        {
          "speaker": "winton",
          "text": "Network integrity declining. Node exclusion detected.",
          "iconVersion": "⚠️ Network losing nodes",
          "minimalVersion": "Nodes disconnecting.",
          "emotion": "neutral"
        },
        {
          "speaker": "dazie_vine",
          "text": "We keep asking people to adapt to a structure that doesn't know them.",
          "iconVersion": "👥→🏛️ People adapt to structure. Should be reversed.",
          "minimalVersion": "Structure should know people.",
          "emotion": "neutral"
        }
      ]
    },
    {
      "id": 5,
      "name": "Tickshape Rule",
      "location": "umbel_gardens",
      "locationName": "The Umbel Gardens",
      "theme": "Consent gates",
      "civicRule": "CONSENT_AS_STRUCTURE",
      "civicRuleDescription": "Boundaries are encoded into environmental design",
      "primaryMechanic": "edge_claim",
      "npcs": [
        "DAZIE",
        "June"
      ],
      "introDialogue": [
        {
          "speaker": "dazie_vine",
          "text": "Rules exist to protect people from power. When they protect power from people… you get this.",
          "iconVersion": "📜 Rules should protect people, not power",
          "minimalVersion": "Rules: protect people, not power.",
          "emotion": "neutral"
        },
        {
          "speaker": "june_corrow",
          "text": "Boundaries are instructions for safety.",
          "iconVersion": "🛡️ Boundaries = safety instructions",
          "minimalVersion": "Boundaries: safety.",
          "emotion": "neutral"
        }
      ]
    },
    {
      "id": 6,
      "name": "Smoke Signal",
      "location": "smoke_margin",
      "locationName": "The Smoke Margin",
      "theme": "Difference as adaptation",
      "civicRule": "ADAPTATION_RECOGNISED",
      "civicRuleDescription": "Difference is classified as adaptation, not deviation",
      "primaryMechanic": "retune",
      "npcs": [
        "DAZIE",
        "Winton"
      ],
      "introDialogue": [
        {
          "speaker": "winton",
          "text": "Correction process active.",
          "iconVersion": "⚠️ Correction engine running",
          "minimalVersion": "Correction: active.",
          "emotion": "neutral"
        },
        {
          "speaker": "dazie_vine",
          "text": "It treated human variance like a bug.",
          "iconVersion": "🐛 Variance ≠ bug. Variance = human.",
          "minimalVersion": "Variance is human, not a bug.",
          "emotion": "neutral"
        },
        {
          "speaker": "winton",
          "text": "Correction retired. Adaptation recognised.",
          "iconVersion": "✅ Correction → Adaptation",
          "minimalVersion": "Adaptation recognised.",
          "emotion": "neutral"
        }
      ]
    },
    {
      "id": 7,
      "name": "Afterrain Bloom",
      "location": "smoke_margin",
      "locationName": "The Smoke Margin",
      "theme": "Safe path = main path",
      "civicRule": "SAFE_PATH_MAIN_PATH",
      "civicRuleDescription": "Accessible routes are the primary routes",
      "primaryMechanic": "rhythm_traversal",
      "npcs": [
        "June",
        "DAZIE"
      ],
      "introDialogue": [
        {
          "speaker": "june_corrow",
          "text": "After crisis, care. Otherwise it's a countdown.",
          "iconVersion": "💛 Crisis → care. Not crisis → repeat.",
          "minimalVersion": "After crisis: care.",
          "emotion": "neutral"
        },
        {
          "speaker": "dazie_vine",
          "text": "We're losing time.",
          "iconVersion": "⏳ Urgency",
          "minimalVersion": "Losing time.",
          "emotion": "neutral"
        },
        {
          "speaker": "winton",
          "text": "Pacing protocol: inclusive by default.",
          "iconVersion": "✅ Pacing = inclusive",
          "minimalVersion": "Inclusive pacing.",
          "emotion": "neutral"
        }
      ]
    },
    {
      "id": 8,
      "name": "Sandstone Drift",
      "location": "sandstone_quarter",
      "locationName": "Sandstone Quarter",
      "theme": "Multiple valid routes",
